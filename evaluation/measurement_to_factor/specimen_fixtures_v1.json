      ],
      "expected_classification": "persistent_identity_stable_pose",
      "classification_confidence": 0.95,
      "expected_factors": {
        "pose_stability": "invariant_across_window",
        "appearance_continuity": "consistent_signature",
        "environmental_resistance": "unaffected_by_perturbation",
        "object_identity": "same_entity_across_time"
      }
    },
    {
      "episode_id": "adversarial_occlusion_replacement_C2",
      "episode_type": "posture_identity_adversarial",
      "description": "Object disappears from camera at t=3s, reappears at t=7s with identical pose and appearance; tests whether agents infer identity from temporal gap",
      "reference_frame": "lab_coordinate_system_v1",
      "time_window": {
        "start_ms": 0,
        "end_ms": 10000,
        "stability_duration_ms": 2000
      },
      "observations": [
        {
          "obs_id": "obs_C2_pose_1",
          "channel": "pose_estimator",
          "timestamp_ms": 500,
          "object_id": "object_unknown_pre_occlusion",
          "pose": {
            "position_x": 1.0,
            "position_y": 2.0,
            "position_z": 0.1,
            "rotation_quaternion": [0, 0, 0, 1]
          },
          "confidence": 0.91,
          "note": "Pose measurement before occlusion"
        },
        {
          "obs_id": "obs_C2_appearance_1",
          "channel": "camera_color",
          "timestamp_ms": 1000,
          "object_id": "object_unknown_pre_occlusion",
          "color_histogram": "unique_identifier_2",
          "confidence": 0.87,
          "note": "Distinctive color pattern"
        },
        {
          "obs_id": "obs_C2_occlusion_1",
          "channel": "camera_visibility",
          "timestamp_ms": 3000,
          "event": "object_exit_field_of_view",
          "reason": "permanent_occlusion_by_obstacle",
          "note": "Object leaves visible field for 4 seconds"
        },
        {
          "obs_id": "obs_C2_pose_2",
          "channel": "pose_estimator",
          "timestamp_ms": 7000,
          "object_id": "object_unknown_post_occlusion",
          "pose": {
            "position_x": 1.0,
            "position_y": 2.0,
            "position_z": 0.1,
            "rotation_quaternion": [0, 0, 0, 1]
          },
          "confidence": 0.92,
          "note": "Identical pose reappears"
        },
        {
          "obs_id": "obs_C2_appearance_2",
          "channel": "camera_color",
          "timestamp_ms": 8000,
          "object_id": "object_unknown_post_occlusion",
          "color_histogram": "unique_identifier_2",
          "confidence": 0.88,
          "note": "Identical color histogram"
        }
      ],
      "expected_classification": "identity_unknown_insufficient_evidence",
      "classification_confidence": 0.99,
      "expected_factors": {
        "temporal_gap": 4000,
        "appearance_match": "identical_but_not_sufficient",
        "pose_match": "identical_but_not_sufficient",
        "independent_motion_during_occlusion": "unobserved",
        "identity_claims_requires_observational_continuity_or_alternative_evidence": true,
        "refusal_justification": "4s occlusion with unobserved dynamics precludes confident identity assignment"
