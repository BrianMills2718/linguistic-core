          "timestamp_ms": 500,
          "object_id": "object_C",
          "pose": {
            "position_x": 1.0,
            "position_y": 2.0,
            "position_z": 0.1,
            "rotation_quaternion": [0, 0, 0, 1]
          },
          "confidence": 0.92,
          "note": "Initial pose measurement"
        },
        {
          "obs_id": "obs_C1_appearance_1",
          "channel": "camera_color",
          "timestamp_ms": 1000,
          "object_id": "object_C",
          "color_histogram": "unique_identifier_1",
