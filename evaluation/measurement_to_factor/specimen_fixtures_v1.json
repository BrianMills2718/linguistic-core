          "note": "Color signature at t=1s"
        },
        {
          "obs_id": "obs_C1_environmental_1",
          "channel": "air_currents",
          "timestamp_ms": 3000,
          "event": "wind_gust_0.5ms",
          "note": "Environmental perturbation"
        },
        {
          "obs_id": "obs_C1_pose_2",
          "channel": "pose_estimator",
          "timestamp_ms": 4000,
          "object_id": "object_C",
          "pose": {
            "position_x": 1.0,
            "position_y": 2.0,
            "position_z": 0.1,
            "rotation_quaternion": [0, 0, 0, 1]
          },
          "confidence": 0.91,
          "note": "Pose unchanged after perturbation"
        },
        {
          "obs_id": "obs_C1_appearance_2",
          "channel": "camera_color",
          "timestamp_ms": 5000,
          "object_id": "object_C",
          "color_histogram": "unique_identifier_1",
          "confidence": 0.89,
          "note": "Same color signature at t=5s"
        },
        {
          "obs_id": "obs_C1_pose_3",
          "channel": "pose_estimator",
          "timestamp_ms": 9000,
          "object_id": "object_C",
          "pose": {
            "position_x": 1.0,
            "position_y": 2.0,
            "position_z": 0.1,
            "rotation_quaternion": [0, 0, 0, 1]
          },
          "confidence": 0.90,
          "note": "Pose still unchanged at end of window"
