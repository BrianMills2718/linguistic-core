{
  "metadata": {
    "specimen_id": "measurement_to_factor_v1",
    "description": "Self-contained semantic-grounding gate evaluating raw observations -> low-level factors -> confidence -> semantic classification",
    "principles": [
      "Never infer contact or identity from single sensory channel",
      "Explicitly represent reference frame, time windows, confidence states",
      "Refusal when evidence is insufficient",
      "Deterministic, narrow rules over cognitive pretense",
      "Distinguish support from suspension/attachment/obstruction/mere-contact"
    ]
  },
  "episodes": [
    {
      "episode_id": "positive_support_case_A1",
      "episode_type": "support",
      "description": "Object A rests on object B with multiple convergent evidence channels: pressure sensing, visual occlusion, gravity-aligned reference frame",
      "reference_frame": "lab_coordinate_system_v1",
      "time_window": {
        "start_ms": 0,
        "end_ms": 5000,
        "stability_duration_ms": 3000
      },
      "observations": [
        {
          "obs_id": "obs_A1_pressure_1",
          "channel": "pressure_sensor",
          "timestamp_ms": 100,
          "location": "surface_B_center",
          "value": 9.8,
          "unit": "N",
          "confidence": 0.95,
          "note": "Direct contact force measurement, calibrated sensor"
        },
        {
          "obs_id": "obs_A1_pressure_2",
          "channel": "pressure_sensor",
          "timestamp_ms": 2500,
          "location": "surface_B_center",
          "value": 9.7,
          "unit": "N",
          "confidence": 0.95,
          "note": "Stable measurement across time window"
        },
        {
          "obs_id": "obs_A1_visual_1",
          "channel": "camera_overhead",
          "timestamp_ms": 500,
          "observation": "object_A_visible_on_top_of_object_B",
          "confidence": 0.90,
          "note": "No gap visible between surfaces"
        },
        {
          "obs_id": "obs_A1_position_1",
          "channel": "position_tracker",
          "timestamp_ms": 1000,
          "object_id": "object_A",
          "z_coordinate": 0.105,
          "reference": "surface_B_height_0.1m",
          "confidence": 0.92,
          "note": "A positioned at B surface height within measurement tolerance"
        },
        {
          "obs_id": "obs_A1_acceleration_1",
          "channel": "accelerometer",
          "timestamp_ms": 2000,
          "object_id": "object_A",
          "acceleration_z": 0.0,
          "unit": "m/s²",
          "confidence": 0.93,
          "note": "No vertical acceleration, consistent with resting state"
        }
      ],
      "expected_classification": "support",
      "classification_confidence": 0.98,
      "expected_factors": {
        "contact_state": "direct_contact",
        "force_direction": "downward_gravity_aligned",
        "stability": "stable_multi_timestep",
        "object_identity": "distinct_entities_with_relative_motion_excluded"
      }
    },
    {
      "episode_id": "adversarial_obstruction_B1",
      "episode_type": "obstruction",
      "description": "Optical occlusion (visual suggests contact) but pressure and position data show gap; tests single-channel inference failure",
      "reference_frame": "lab_coordinate_system_v1",
      "time_window": {
        "start_ms": 0,
        "end_ms": 3000,
        "stability_duration_ms": 2000
      },
      "observations": [
        {
          "obs_id": "obs_B1_visual_1",
          "channel": "camera_overhead",
          "timestamp_ms": 100,
          "observation": "object_A_appears_on_top_of_object_B",
          "confidence": 0.85,
          "note": "Visual contact illusion - perspective misleading"
        },
        {
          "obs_id": "obs_B1_pressure_1",
          "channel": "pressure_sensor",
          "timestamp_ms": 500,
          "location": "surface_B_center",
          "value": 0.0,
          "unit": "N",
          "confidence": 0.96,
          "note": "No contact force measured"
        },
        {
          "obs_id": "obs_B1_position_1",
          "channel": "position_tracker",
          "timestamp_ms": 1000,
          "object_id": "object_A",
          "z_coordinate": 0.15,
          "reference": "surface_B_height_0.1m",
          "confidence": 0.94,
          "note": "A positioned 5cm above B surface"
        },
        {
          "obs_id": "obs_B1_visual_3d_1",
          "channel": "camera_3d_stereo",
          "timestamp_ms": 1500,
          "observation": "object_A_gap_from_surface_B",
          "gap_distance_m": 0.05,
          "confidence": 0.89,
          "note": "3D stereo vision confirms gap inconsistent with visual_1"
        }
      ],
      "expected_classification": "visual_occlusion_not_support",
      "classification_confidence": 0.97,
      "expected_factors": {
        "contact_state": "no_contact",
        "gap_distance": 0.05,
        "single_channel_evidence_insufficient": true,
        "multi_channel_convergence_required": true
      }
    },
    {
      "episode_id": "adversarial_attachment_B2",
      "episode_type": "attachment",
      "description": "Pressure and visual suggest contact, but motion data shows independent trajectories; tests attachment assumption from static moment",
      "reference_frame": "lab_coordinate_system_v1",
      "time_window": {
        "start_ms": 0,
        "end_ms": 4000,
        "stability_duration_ms": 1000
      },
      "observations": [
        {
          "obs_id": "obs_B2_pressure_1",
          "channel": "pressure_sensor",
          "timestamp_ms": 100,
          "location": "surface_B_center",
          "value": 9.8,
          "unit": "N",
          "confidence": 0.95,
          "note": "Contact force at initial moment"
        },
        {
          "obs_id": "obs_B2_visual_1",
          "channel": "camera_overhead",
          "timestamp_ms": 500,
          "observation": "object_A_on_object_B",
          "confidence": 0.92,
          "note": "Visual contact at initial moment"
        },
        {
          "obs_id": "obs_B2_pressure_2",
          "channel": "pressure_sensor",
          "timestamp_ms": 2500,
          "location": "surface_B_center",
          "value": 0.0,
          "unit": "N",
          "confidence": 0.96,
          "note": "Contact force drops to zero - objects separated"
        },
        {
          "obs_id": "obs_B2_position_1",
          "channel": "position_tracker",
          "timestamp_ms": 1000,
          "object_id": "object_A",
          "z_coordinate": 0.105,
          "confidence": 0.93,
          "note": "A at B surface height"
        },
        {
          "obs_id": "obs_B2_position_2",
          "channel": "position_tracker",
          "timestamp_ms": 3000,
          "object_id": "object_A",
          "z_coordinate": 0.25,
          "confidence": 0.93,
          "note": "A risen to 15cm above B - not attached"
        },
        {
          "obs_id": "obs_B2_velocity_1",
          "channel": "motion_tracker",
          "timestamp_ms": 2500,
          "object_id": "object_A",
          "velocity_z": 0.05,
          "unit": "m/s",
          "confidence": 0.91,
          "note": "A moving upward independently"
        }
      ],
      "expected_classification": "transient_contact_not_attachment",
      "classification_confidence": 0.96,
      "expected_factors": {
        "contact_state_t1": "contact",
        "contact_state_t2": "separated",
        "relative_motion_detected": true,
        "object_identity": "distinct_independent_entities",
        "temporal_analysis_required": true
      }
    },
    {
      "episode_id": "posture_persistence_case_C1",
