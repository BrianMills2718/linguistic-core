  "semantic_target": {
    "unit": "foot x non-overlapping time window",
    "classes": [
      "load_bearing_contact_evidence",
      "no_load_bearing_contact_evidence",
      "REFUSAL:transition_or_uncertain"
    ],
    "claim_boundary": "Evidence for sustained vertical load-bearing contact only. It is not equivalent to metaphysical contact or the full support relation."
  },
  "evidence_separation": {
    "inference_inputs": "Eight individual VGRF sensors for one foot only.",
    "withheld_reference": "Recorded per-foot total-force channel.",
    "forbidden_inputs": [
      "clinical group label",
      "demographics",
      "disease severity",
      "opposite foot total-force reference"
    ],
    "reference_role": "Physical reference channel used only after inference for scoring."
  },
  "fixed_rules": {
    "window_samples": 20,
    "window_duration_ms": 200,
    "window_stride_samples": 20,
    "no_load_force_max_n": 20,
    "load_bearing_force_min_n": 100,
    "persistence_fraction": 0.8,
    "inference_force_per_sample": "sum of the eight individual VGRF sensors for the foot",
    "classification": [
      "load_bearing_contact_evidence if >=80% of samples have inferred force >=100 N",
      "no_load_bearing_contact_evidence if >=80% of samples have inferred force <=20 N",
      "otherwise REFUSAL:transition_or_uncertain"
    ],
    "reference_construction": [
      "Apply the same temporal band rules to the withheld total-force channel.",
      "Reference refusal windows are excluded from binary error rates but reported as ambiguous physical-reference intervals."
    ],
    "tuning_policy": "No threshold changes based on calibration or held-out outcomes in v1. If thresholds are empirically inadequate, report the failure and create a separately versioned plan."
  },
  "robustness_tests": {
    "external_data": [
      "stance/load windows",
      "swing/near-zero-load windows",
      "loading/unloading transition windows"
    ],
    "synthetic_or_transformed": [
      {
        "test": "sensor_order_permutation",
        "expectation": "exactly invariant"
      },
      {
        "test": "single_sensor_dropout",
        "expectation": "report coverage/error degradation separately; no tuning"
      },
      {
        "test": "left_right_logic_symmetry",
        "expectation": "same rule for each foot"
      }
    ]
  },
  "metrics": [
    "coverage on non-ambiguous withheld-reference windows",
    "false load-bearing positives",
    "false no-load predictions",
    "refusal count and rate",
    "per-subject metrics",
    "sensor-permutation invariance",
    "single-sensor-dropout degradation"
  ],
  "stop_rules": [
    "Do not claim full support grounding from force evidence alone.",
    "Do not change v1 thresholds after seeing outcomes.",
